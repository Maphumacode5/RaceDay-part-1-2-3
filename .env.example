# Copy this file to ".env" (which is git-ignored) to override the defaults in docker-compose.yml.

# Password for the SQL Server container (must meet SQL Server complexity rules).
SA_PASSWORD=RaceDay_Str0ng_Pass1

# --- Real Azure Blob Storage (leave both commented out to use the Azurite emulator) ---
# Find the connection string in the Azure portal: Storage account > Security + networking > Access keys.
# BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
# BLOB_PUBLIC_BASE_URL=https://<account>.blob.core.windows.net
